<?xml version="1.0"?>
<ruleset name="Cost Importer for WooCommerce">
  <description>WordPress coding standards for distributable plugin source.</description>
  <file>cost-importer-for-woocommerce.php</file>
  <file>includes</file>
  <rule ref="WordPress">
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="WordPress.PHP.DevelopmentFunctions"/>
    <exclude name="WordPress.Commenting"/>
    <exclude name="WordPress.WhiteSpace"/>
    <exclude name="WordPress.Arrays"/>
    <exclude name="WordPress.PHP.YodaConditions"/>
    <exclude name="WordPress.WP.I18n"/>
  </rule>
  <rule ref="PHPCompatibility" />
  <config name="testVersion" value="7.4-"/>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
